# The Phase 1 foundation exposes health endpoints only.
PORT=8086
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required only when an API or worker needing PostgreSQL is enabled.
DATABASE_URL=
# Must match the user-service customer JWT signing secret. Supply from a secret manager.
CUSTOMER_JWT_SECRET=
# Reserved for authenticated restaurant-service/internal calls.
INTERNAL_SERVICE_TOKEN=
AWS_REGION=ap-south-1
LOYALTY_ORDER_EVENTS_QUEUE_URL=
LOYALTY_RESERVATION_TTL=2m

# These kill switches must remain false while the service is in foundation mode.
LOYALTY_READ_API_ENABLED=false
LOYALTY_INTERNAL_API_ENABLED=false
LOYALTY_EVENT_CONSUMPTION_ENABLED=false
LOYALTY_EARNING_ENABLED=false
LOYALTY_REDEMPTION_ENABLED=false
LOYALTY_REFERRALS_ENABLED=false
LOYALTY_BIRTHDAY_ENABLED=false
LOYALTY_COUPON_ADAPTER_ENABLED=false
